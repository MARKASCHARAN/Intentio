# Agora Credentials (NEVER commit to git — add .env to .gitignore)
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Agora REST API (from Agora Console → RESTful API)
AGORA_API_KEY=your_agora_rest_api_key_here
AGORA_API_SECRET=your_agora_rest_api_secret_here

# Server Configuration
PORT=3000
MCP_PORT=3001

# Token Configuration
TOKEN_EXPIRY_SECONDS=3600
